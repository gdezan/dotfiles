typeset -U path
[[ -d "$HOME/.local/bin" ]] && path=("$HOME/.local/bin" $path)

if [[ -z "$SSH_AUTH_SOCK" && -n "$XDG_RUNTIME_DIR" && -S "$XDG_RUNTIME_DIR/shell-ssh-agent.sock" ]]; then
  export SSH_AUTH_SOCK="$XDG_RUNTIME_DIR/shell-ssh-agent.sock"
fi

if [[ -n "$WSL_DISTRO_NAME" || "$(uname -r)" == *[Mm]icrosoft* ]]; then
  export NVM_DIR="$HOME/.nvm"
  [[ -s "$NVM_DIR/nvm.sh" ]] && source "$NVM_DIR/nvm.sh"
  export PNPM_HOME="$HOME/.local/share/pnpm"
  [[ -d "$PNPM_HOME" ]] && path=("$PNPM_HOME" $path)
  export TMP_DIR=/tmp TMPDIR=/tmp TMP=/tmp TEMP=/tmp
  [[ -f "$HOME/.cargo/env" ]] && source "$HOME/.cargo/env"
fi
