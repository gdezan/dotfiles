#!/usr/bin/env bash
set -euo pipefail
repo=$(cd "$(dirname "$0")/.." && pwd)
backup_root="$HOME/.local/state/dotfiles-backups"
mappings=('fish/config.fish:.config/fish/config.fish' 'systemd/shell-ssh-agent.service:.config/systemd/user/shell-ssh-agent.service' '.zshrc:.zshrc' 'zsh/zshenv:.zshenv' 'starship.toml:.config/starship.toml')
if [[ -n "${STARSHIP_CONFIG:-}" && "$STARSHIP_CONFIG" != "$HOME/.config/starship.toml" ]]; then
    printf 'STARSHIP_CONFIG points elsewhere; refusing to deploy to the default path\n' >&2
    exit 1
fi
for mapping in "${mappings[@]}"; do
    if [[ ! -f "$repo/${mapping%%:*}" ]]; then
        printf 'Missing shell configuration: %s\n' "$repo/${mapping%%:*}" >&2
        exit 1
    fi
    target_path="$HOME/${mapping#*:}"
    if [[ -d "$target_path" && ! -L "$target_path" ]]; then
        printf 'Shell configuration target is a directory: %s\n' "$target_path" >&2
        exit 1
    fi
done
umask 077
mkdir -p "$backup_root"
backup=$(mktemp -d "$backup_root/shell-$(date +%Y%m%d-%H%M%S)-XXXXXXXX")
for mapping in "${mappings[@]}"; do
    source_path="$repo/${mapping%%:*}"
    target_relative=${mapping#*:}
    target_path="$HOME/$target_relative"
    if [[ -e "$target_path" || -L "$target_path" ]]; then
        mkdir -p "$backup/$(dirname "$target_relative")"
        cp -a -- "$target_path" "$backup/$target_relative"
    fi
    mkdir -p "$(dirname "$target_path")"
    temporary=$(mktemp "$(dirname "$target_path")/.shell-deploy-XXXXXXXX")
    install -m 644 -- "$source_path" "$temporary"
    mv -fT -- "$temporary" "$target_path"
done
printf 'Backed up existing files to %s\n' "$backup"
printf 'Deployed shell and Starship configuration. No service or login shell was changed.\n'
